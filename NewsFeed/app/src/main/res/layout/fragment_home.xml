<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Shimmer layout that shows during loading -->
    <include
        android:id="@+id/shimmer_layout"
        layout="@layout/home_shimmer_layout"
        android:visibility="gone" />

    <!-- Main content with SwipeRefreshLayout -->
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nested_scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!-- Main News Card -->
                <nfr.newsfeed.views.MainNewsCardView
                    android:id="@+id/main_news_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Latest News Carousel Title -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/latest_news"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="16dp" />

                <!-- Latest News Carousel -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/featuredNewsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <!-- Category News Title -->
                <TextView
                    android:id="@+id/categoryTitleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/featured_news"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:padding="16dp" />

                <!-- Category News List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp"
                    android:nestedScrollingEnabled="false" />

                <!-- Progress bar for pagination loading -->
                <ProgressBar
                    android:id="@+id/pagination_progress_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    style="?android:attr/progressBarStyle"
                    android:layout_margin="16dp" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>